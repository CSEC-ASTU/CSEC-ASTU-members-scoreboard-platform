# Server-side backend origin (no /api/v1). Used by the /api/proxy rewrite and by
# server-rendered pages (landing events, certificate verify, share cards).
# Defaults: http://localhost:8000 in dev, the Render URL in production builds.
BACKEND_URL=http://localhost:8000

# Optional browser-side API base. Leave unset to use http://localhost:8000/api/v1 locally
# and the same-origin /api/proxy rewrite on deployed hosts (keeps auth cookies first-party).
# NEXT_PUBLIC_API_BASE_URL=
