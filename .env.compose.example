# Copy to `.env` in the repo root (Compose auto-loads it), then fill every blank.
# Never commit your real `.env`.
#
# Generate local secrets, for example:
#   openssl rand -hex 32

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=csec_astu

# Must match POSTGRES_* above, e.g.
# postgresql+asyncpg://USER:PASSWORD@db:5432/csec_astu
DATABASE_URL=

JWT_SECRET_KEY=
INTERNAL_API_SECRET=
TELEGRAM_WEBHOOK_SECRET=

# Telegram (required for live bot messages / webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_CHAT_IDS=[]

# Google OAuth (required for login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Optional crash alerting
SENTRY_DSN=
