# Application
APP_NAME=CSEC ASTU Member Management
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# Database (Aiven Postgres or local)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/csec_astu

# JWT / cookies
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ACCESS_COOKIE_NAME=csec_access
REFRESH_COOKIE_NAME=csec_refresh

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Google Drive (service account) — profile pictures only
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/service-account.json
# Or paste the full JSON as a single line:
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Points / workload (improvement: auto-approve low-stakes claims)
AUTO_APPROVE_CLAIM_MAX_POINTS=10
PROFILE_PICTURE_MAX_BYTES=2097152

# Telegram bot integration
TELEGRAM_BOT_URL=http://localhost:8001
INTERNAL_API_SECRET=change-me-internal-secret
TELEGRAM_BOT_USERNAME=
