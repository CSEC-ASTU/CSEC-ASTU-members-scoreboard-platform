# ==============================================================================
# 1. APPLICATION & ENVIRONMENT
# ==============================================================================
APP_NAME="CSEC ASTU Member Management"
APP_ENV=development
DEBUG=true
PYTHON_VERSION=3.12.3
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# ==============================================================================
# 2. DATABASE (PostgreSQL with asyncpg)
# ==============================================================================
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/csec_astu
RUN_MIGRATIONS_ON_STARTUP=true

# ==============================================================================
# 3. AUTHENTICATION & SECURITY (JWT & Cookies)
# ==============================================================================
# Required: Random string >= 32 characters. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Cookies (Set COOKIE_SECURE=true in production with HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ACCESS_COOKIE_NAME=csec_access
REFRESH_COOKIE_NAME=csec_refresh

AUTO_APPROVE_CLAIM_MAX_POINTS=10

# ==============================================================================
# 4. GOOGLE OAUTH 2.0 (Sign-In with Google)
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ==============================================================================
# 5. GOOGLE DRIVE (Profile Pictures Storage)
# ==============================================================================
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/service-account.json
# Or paste single-line JSON:
# GOOGLE_SERVICE_ACCOUNT_JSON=
PROFILE_PICTURE_MAX_BYTES=2097152

# ==============================================================================
# 6. GOOGLE APPS SCRIPT (GAS Engine: Certificate PDFs & Presidential Email)
# ==============================================================================
# Web App URL generated when deploying gas/Code.gs:
APPS_SCRIPT_WEBHOOK_URL=
# Shared secret: Must match CSEC_APPS_SCRIPT_SECRET in GAS Script Properties (>= 24 chars):
APPS_SCRIPT_SECRET=

# ==============================================================================
# 7. TELEGRAM BOT INTEGRATION
# ==============================================================================
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MOTIVATIONAL_MIN_POINTS=40
TELEGRAM_ADMIN_CHAT_IDS=[]
# Optional standalone service settings:
TELEGRAM_BOT_URL=
INTERNAL_API_SECRET=

# ==============================================================================
# 8. NETWORK & RATE LIMITING
# ==============================================================================
# 1 = Render/direct local dev; 2 = Production Vercel /api/proxy rewrite
TRUSTED_PROXY_HOPS=1
