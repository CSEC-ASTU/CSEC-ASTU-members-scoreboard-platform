# Telegram bot service (separate from FastAPI backend)
APP_NAME=CSEC ASTU Telegram Bot
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8001

# Same Postgres as the backend (shared members / notifications / point_events)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/csec_astu

# BotFather credentials — live only in this service
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=change-me-long-random-secret

# Shared secret for backend → bot internal calls
INTERNAL_API_SECRET=change-me-internal-secret

TELEGRAM_MOTIVATIONAL_MIN_POINTS=40
TELEGRAM_ADMIN_CHAT_IDS=[]
